{
  "name": "genie",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:manager\" \"npm run dev:renderer\"",
    "dev:renderer": "cd packages/renderer && next dev",
    "dev:manager": "npx tsx watch packages/manager/src/index.ts",
    "build": "npm run build:manager && npm run build:vps-agent && npm run build:vps-stats && npm run build:renderer && npm run build:extension",
    "build:vps-agent": "tsc -p packages/vps-agent/tsconfig.json",
    "build:vps-stats": "tsc -p packages/vps-stats/tsconfig.json",
    "build:extension": "cd packages/chrome-extension && npx webpack --mode production",
    "dev:extension": "cd packages/chrome-extension && npx webpack --mode development --watch",
    "build:renderer": "cd packages/renderer && next build",
    "build:manager": "tsc -p packages/manager/tsconfig.json",
    "start": "concurrently \"npm run start:manager\" \"npm run start:renderer\"",
    "start:manager": "node packages/manager/dist/index.js",
    "start:renderer": "cd packages/renderer && next start",
    "manager": "npx tsx packages/manager/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
