{
  "name": "genie",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:manager\" \"npm run dev:renderer\"",
    "dev:renderer": "cd packages/renderer && next dev",
    "dev:manager": "node scripts/free-port-9876.mjs && PORT=9876 npx tsx watch packages/manager/src/index.ts",
    "build": "npm run build:vps-stats && npm run build:vps-agent && npm run build:manager && npm run build:renderer && npm run build:extension",
    "build:vps-agent": "tsc -p packages/vps-agent/tsconfig.json",
    "build:vps-stats": "tsc -p packages/vps-stats/tsconfig.json",
    "build:extension": "cd packages/chrome-extension && npx webpack --mode production",
    "dev:extension": "cd packages/chrome-extension && npx webpack --mode development --watch",
    "build:renderer": "npm run build -w @genie/renderer",
    "build:manager": "tsc -p packages/manager/tsconfig.json",
    "start": "concurrently \"npm run start:manager\" \"npm run start:renderer\"",
    "start:manager": "node packages/manager/dist/index.js",
    "start:renderer": "npm run start -w @genie/renderer",
    "manager": "npx tsx packages/manager/src/index.ts",
    "knowledge:export": "npx tsx packages/manager/src/scripts/export-knowledge.ts",
    "knowledge:import": "npx tsx packages/manager/src/scripts/import-knowledge.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
