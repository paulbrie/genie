{
  "name": "@genie/manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "postinstall": "node -e \"const p=require('path'),fs=require('fs');const d=p.join(p.dirname(require.resolve('node-pty')),'..','prebuilds');if(fs.existsSync(d)){const r=fs.readdirSync(d);r.forEach(a=>{const h=p.join(d,a,'spawn-helper');if(fs.existsSync(h))fs.chmodSync(h,0o755)})}\""
  },
  "dependencies": {
    "@genie/vps-stats": "*",
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/fireworks": "^2.0.40",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "@slack/bolt": "^4.6.0",
    "ai": "^6.0.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.44.0",
    "fast-xml-parser": "^4.5.1",
    "google-auth-library": "^10.6.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.1.0",
    "pidusage": "^3.0.2",
    "postgres": "^3.4.5",
    "socks": "^2.8.9",
    "ssh2": "^1.17.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
